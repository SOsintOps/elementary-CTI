# uv — uv.lock is deliberately TRACKED. This is an application, not a
# library, and the Dockerfile runs `uv sync --frozen`, which cannot work
# without it: a fresh clone failed to build at all until it was committed.

# Local embedding vector cache (A1) — regenerable, never committed
.embedding-cache/

# Local embedding model (A2) — fetched by scripts/fetch_embedding_model.py
.embedding-model/

# Weekly API-sentinel drift reports — regenerable, never committed
.reports/

# Hailo runtime log — artefact, never tracked
hailort.log
