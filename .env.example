# "The world is full of obvious things which nobody by any chance ever observes." — Sherlock Holmes, Elementary
# Elementary CTI — environment variables
# Copy to .env and fill in values

# Database
PEST_DB_URL=sqlite:///elementaryctiDB.db
# PEST_DB_URL=postgresql://user:pass@localhost:5432/pestilentia

# Logging
PEST_LOG_LEVEL=INFO

# API sources
PEST_API_BASE_URL=https://api.ransomware.live/v2

# Scheduler
PEST_POLL_INTERVAL_HOURS=4

# Web server
PEST_WEB_HOST=0.0.0.0
PEST_WEB_PORT=8000

# Fuzzy matching
PEST_FUZZY_THRESHOLD=85

# Security (CSRF token signing — generate with: python -c "import secrets; print(secrets.token_hex(32))")
PEST_SECRET_KEY=change-me-in-production

# Docker Compose (Postgres) — required by docker-compose.yml
POSTGRES_PASSWORD=change-me-strong-password
# POSTGRES_USER=pestilentia
# POSTGRES_DB=pestilentia

# TLS proxy (Caddy). The app itself publishes no host port: all access goes
# through https on the caddy service. PEST_DOMAIN is the site address —
# localhost (default), a LAN name/IP, or the real public domain at go-live.
# PEST_TLS_MODE stays "internal" (Caddy's own CA, self-signed) until go-live;
# set it to an ACME e-mail address to switch to Let's Encrypt.
# PEST_DOMAIN=localhost
# PEST_TLS_MODE=internal
# Trusted proxy network for X-Forwarded-For — must match the compose subnet.
# PEST_TRUSTED_PROXY_CIDR=172.28.0.0/16

# Optional HTTP Basic Auth for web UI + API (set both to enable, neither to disable).
# v0.7 auth plan: on first startup with an empty users table this pair also
# seeds the initial ADMIN account for the session login; once accounts exist
# it is bootstrap-only and Basic Auth is retired at plan step 4.
# PEST_AUTH_USER=analyst
# PEST_AUTH_PASS=choose-a-strong-password

# Session cookie Secure flag. The default (true) is correct behind the Caddy
# TLS proxy; false exists only for proxy-less plain-HTTP development.
# PEST_COOKIE_SECURE=true

# user_activity log retention in days (purged on the scheduler cycle)
# PEST_ACTIVITY_RETENTION_DAYS=90

# Enrichment intervals (hours)
PEST_MITRE_ENRICHMENT_HOURS=168
PEST_RANSOMWHERE_ENRICHMENT_HOURS=168
PEST_DEEPDARKCTI_ENRICHMENT_HOURS=168

# Article ingest cadence (0 = every scheduler cycle; see config.py for why)
PEST_ARTICLE_INGEST_HOURS=0

# --- AI pipeline (ADR-006 Phase 3) ---
# Cloud TLP boundary: content at this level or below may reach a third-party LLM.
# clear|green|amber|amber+strict|red. Default green — AMBER+ never leaves.
PEST_AI_TLP_CLOUD_MAX=green
# Spend caps (USD): degrade to cheap tier at 80% of daily, refuse at 100%.
PEST_AI_DAILY_BUDGET_USD=2.0
PEST_AI_MONTHLY_BUDGET_USD=30.0
# Per-article token ceiling — one pathological document cannot spend the day.
PEST_AI_MAX_TOKENS_PER_ARTICLE=50000
# Confidence gate (Phase 5). Fractions, not percentages: a value outside 0..1
# aborts at start-up rather than being coerced to something permissive.
# A finding must clear its category floor AND the overall one to enrich the
# adversary tables directly; anything else lands in the review queue.
PEST_AI_GATE_IOC_MIN=0.85
PEST_AI_GATE_TTP_MIN=0.70
PEST_AI_GATE_NARRATIVE_MIN=0.90
PEST_AI_GATE_SKETCH_MIN=0.75
PEST_AI_GATE_OVERALL_MIN=0.75
# Local-model runs lift every threshold by this much, so a small local model is
# harder to trust automatically. It lifts the thresholds, never the score.
PEST_AI_GATE_LOCAL_LIFT=0.10
# Model per tier (verify ids against the provider before trusting them).
PEST_AI_MODEL_TRIAGE=claude-haiku-4-5
PEST_AI_MODEL_ANALYSIS=claude-sonnet-5
PEST_AI_MODEL_LOCAL=qwen2.5:1.5b

# Campaign clustering vectoriser: auto (prefer embeddings, fall back to TF-IDF)
# | embedding | tfidf
PEST_AI_CLUSTER_BACKEND=auto

# NVIDIA NIM API key (build.nvidia.com > Settings > API Keys, free tier).
# The preferred cloud provider since 2026-08-09; empty means the nvidia
# provider refuses at call time with a message naming this setting.
PEST_AI_NVIDIA_API_KEY=
# Certificate for no-SNI (raw-IP) clients — set to the LAN IP when used
# PEST_DEFAULT_SNI=192.168.178.88
